# Copy to .env (never commit .env) and replace every placeholder.
# Use letters and digits only in passwords: the backend connection string is a URL,
# so characters such as @ / : # would break it.

# Must stay "bookstore": the repository's schema and seed files run USE bookstore.
MYSQL_DATABASE=bookstore
MYSQL_USER=epicbook_app
MYSQL_PASSWORD=replace_with_app_password
MYSQL_ROOT_PASSWORD=replace_with_root_password
